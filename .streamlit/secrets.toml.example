# Streamlit Secrets 配置示例
#
# 使用方法：
# 1. 本地开发：复制此文件为 .streamlit/secrets.toml 并填入实际值
# 2. Streamlit Cloud：在应用设置 → Secrets 中粘贴下方配置
#
# 数据库选择（三选一）：
#   1. MySQL：填写 [mysql] 并设置 database_backend = "mysql"
#   2. PostgreSQL：填写 [postgres] 并设置 database_backend = "postgres"
#   3. 都不配：自动使用本地 SQLite（Streamlit Cloud 重启后数据会丢失）
#
# 请只保留实际使用的数据库区块；不要把下面的示例地址、密码直接粘贴到 Cloud Secrets。

# ============================================================
# Supabase PostgreSQL 配置（推荐）
# ============================================================
database_backend = "postgres"

# Supabase 连接池配置（从 Supabase Dashboard → Database → Connection 复制）
[postgres]
host = "aws-0-ap-northeast-1.pooler.supabase.com"   # Supabase Pooler 地址
port = 6543                                          # Supabase Pooler 端口
dbname = "postgres"
user = "postgres.your-project-ref"                   # 你的 Supabase 项目用户名
password = "your-database-password"                  # 你的数据库密码
sslmode = "require"
connect_timeout = 15

# 或者使用 DATABASE_URL（与上面二选一）
# database_url = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# ============================================================
# MySQL 配置（可选，云服务或本地均可）
# ============================================================
# database_backend = "mysql"
# [mysql]
# host = "your-mysql-host.com"          # 云服务地址或 localhost
# port = 3306
# user = "root"
# password = "your-password-here"
# database = "customer_points"
# charset = "utf8mb4"

# ============================================================
# IMAP 邮箱配置（保留，供 invoice_fetcher 使用）
# ============================================================
[imap]
server = "imap.qiye.163.com"
port = 993
email = "huiyin.guo@ibiologistics.com"
password = "your-imap-auth-code"
sender = "百旺金穗云dzfpswpt@hnfapiao.com"
subject_filter = "开具的发票"
days_back = 5