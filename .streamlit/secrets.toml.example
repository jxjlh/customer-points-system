# Streamlit Secrets 配置示例
#
# 使用方法：
# 1. 本地开发：复制此文件为 .streamlit/secrets.toml 并填入实际值
# 2. Streamlit Cloud：在应用设置 → Secrets 中粘贴下方配置
#
# PostgreSQL 数据库服务推荐：
# - Supabase (https://supabase.com) - 免费500MB
# - Neon (https://neon.tech) - 免费分支
# - Render (https://render.com) - 免费90天

[postgres]
host = "your-db-host.supabase.co"
port = 5432
dbname = "postgres"
user = "postgres"
password = "your-password-here"
sslmode = "require"
connect_timeout = 10
