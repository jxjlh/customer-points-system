# Streamlit Secrets 配置示例
#
# 使用方法：
# 1. 本地开发：复制此文件为 .streamlit/secrets.toml 并填入实际值
# 2. Streamlit Cloud：在应用设置 → Secrets 中粘贴下方配置
#
# 数据库选择（三选一）：
#   1. MySQL（推荐）：配置 [mysql] 区块
#   2. PostgreSQL：配置 [postgres] 区块
#   3. 都不配：自动降级到本地 SQLite

# ============================================================
# MySQL 配置（推荐，云服务或本地均可）
# ============================================================
[mysql]
host = "your-mysql-host.com"          # 云服务地址或 localhost
port = 3306
user = "root"
password = "your-password-here"
database = "customer_points"
charset = "utf8mb4"

# MySQL 云服务商推荐：
# - 阿里云 RDS：https://www.aliyun.com/product/rds/mysql
# - 腾讯云 TencentDB：https://cloud.tencent.com/product/cdb
# - AWS RDS：https://aws.amazon.com/rds/
# - 免费：PlanetScale (https://planetscale.com)、免费 5GB

# ============================================================
# PostgreSQL 配置（可选，如需使用）
# ============================================================
# [postgres]
# host = "your-db-host.supabase.co"
# port = 5432
# dbname = "postgres"
# user = "postgres"
# password = "your-password-here"
# sslmode = "require"

# ============================================================
# IMAP 邮箱配置（保留，供 invoice_fetcher 使用）
# ============================================================
[imap]
server = "imap.qiye.163.com"
port = 993
email = "huiyin.guo@ibiologistics.com"
password = "your-imap-auth-code"
sender = "百旺金穗云dzfpswpt@hnfapiao.com"
subject_filter = "开具的发票"
